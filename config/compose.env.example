# Copy this file to an untracked `.env`, then replace every placeholder.
BMANGA_AUTH_USER=bmanga
BMANGA_AUTH_PASSWORD=change-this-before-starting
BMANGA_SESSION_SECRET=change-this-before-starting-with-an-independent-random-value

# Bind to loopback unless a trusted reverse proxy is configured.
BMANGA_BIND_ADDRESS=127.0.0.1
BMANGA_PORT=8765
BMANGA_COOKIE_SECURE=0

# Use an absolute host path containing only material you are authorized to read.
BMANGA_LIBRARY_PATH=/absolute/path/to/your/manga-library
BMANGA_LIBRARY_CONFIG_PATH=./config/libraries.json

# Optional build provenance labels.
BMANGA_IMAGE=bmanga:local
BMANGA_VERSION=0.0.0-dev
BMANGA_REVISION=local
BMANGA_SOURCE_URL=https://github.com/zzzcws/bmanga-core
